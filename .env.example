# NVIDIA NIM API keys — comma-separated for rotation/failover (all support vision).
# The loop round-robins across keys and fails over on 429s, so add as many as you have.
NVAPI_KEY=
# NVAPI_KEYS=key1,key2,key3

# Optional: SynthID / watermark verification REST endpoint (multipart image upload).
# When unset, the provenance layer records not_configured and never fakes a result.
# SFIP_SYNTHID_ENDPOINT=https://your-verification-endpoint.example/verify
# SFIP_SYNTHID_TOKEN=

# Optional: polite-pool contact for OpenAlex/Crossref rate-limit friendliness
CONTACT_EMAIL=

# Optional overrides
# SFIP_LLM_MODEL=meta/muse-glimmer-30b
# SFIP_MAX_PAPERS=40
# SFIP_MAX_RUNTIME_MINUTES=180
