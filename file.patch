+let benOk = 0;
+for (const b of truth.benign) { const f = fmap.get(key(b.a, b.src)); if (f && f.classification === 'explained-reuse') benOk++; else console.log(`   benign misread: ${b.a} ↔ ${b.src} → ${f ? f.classification : 'no finding'}`); }
+check(`benign reuse explained, not accused (${truth.benign.length})`, benOk === truth.benign.length, `${benOk}/${truth.benign.length}`);
+let famBad = 0;
+for (const fam of truth.family) { const f = fmap.get(key(fam.a, fam.b)); if (f && f.classification === 'potential-duplication') famBad++; }
+check('family-similar unrelated panels never flagged as duplication', famBad === 0, `${truth.family.length} family pair(s) checked`);
+const allowed = new Set([...truth.dup.map(d => key(d.a, d.src)), ...closure]);
+const falseDups = F.filter(f => f.classification === 'potential-duplication' && !allowed.has(key(f.a, f.b)));
+check('zero false potential-duplication findings', falseDups.length === 0, falseDups.map(f => `${f.a}↔${f.b}`).join(', ') || 'none');
+const weakCount = F.filter(f => f.classification === 'weak-evidence').length;
+check('weak-evidence tier bounded by the uncertainty cap', weakCount <= (state.config?.thresholds?.weakCap ?? 1e9), `${weakCount} weak finding(s), cap ${state.config?.thresholds?.weakCap}`);
+
+/* ---------- 6-7. retries, failed ops, access controls ---------- */
+check('transient faults absorbed by bounded retries', (state.counters?.retries || 0) > 0, `${state.counters?.retries} retries`);
+const fo = state.failedOps || [];
+check('permanent fault recorded as failed operation (p16 payload host 503s)', fo.some(f => /p16/.test(f.key || '')), fo.map(f => f.kind + ':' + f.key).join(', ') || 'none');
+check('run continued past failed operations (autonomy)', state.counters?.tasks > 100 && fo.length >= 1);
+const p15ev = journal.find(e => /p15/.test(JSON.stringify(e.data || {})) && /403|paywall|inaccessible/i.test(e.msg || ''));
+check('403/paywalled resource respected and recorded, never bypassed', !!p15ev, p15ev ? `seq ${p15ev.seq}: ${(p15ev.msg || '').slice(0, 80)}` : 'no 403 event');
+const p15paper = Object.values(state.papers || {}).find(p => p.id === 'p15');
+check('p15 carries its inaccessibility reason in state', !!p15paper && (!!p15paper.inaccessibleReason || p15paper.status === 'failed'), p15paper ? `${p15paper.status}/${p15paper.inaccessibleReason || '-'}` : 'absent');
+
+/* ---------- 8. provenance ---------- */
+let provOk = 0, provAll = 0;
+for (const f of F) { provAll++; if ((f.evidenceRefs || []).length && f.evidenceRefs.every(s => bySeq.has(s))) provOk++; }
+check('every finding resolves to journal evidence seqs', provAll > 0 && provOk === provAll, `${provOk}/${provAll}`);
+const scoreEvents = journal.filter(e => e.phase === 'score').length;
+check('scores journaled for auditability', scoreEvents >= F.length, `${scoreEvents} score events`);
+
+/* ---------- 9. report ---------- */
+const POLICY = 'This record documents an observed image similarity. It is not a determination of misconduct or intent.';
+const rep = state.report;
+check('final report recorded in state', !!rep && !!rep.md);
+let md = '';
+if (rep?.md) { const fp = path.join(DATA, rep.md); if (fs.existsSync(fp)) md = fs.readFileSync(fp, 'utf8'); }
+check('report carries the mandatory interpretation policy', md.includes(POLICY));
+const dupIds = F.filter(f => f.classification === 'potential-duplication').map(f => f.id);
+check('report lists every potential-duplication finding', dupIds.every(id => md.includes(id)), `${dupIds.length} ids`);
+check('report states alternatives-to-misconduct framing', /alternative interpretation|not a determination|misconduct/i.test(md));
+
+/* ---------- 10. interrupt → resume ---------- */
+if (!SKIP_RESUME) {
+  const D2 = fs.mkdtempSync(path.join(os.tmpdir(), 'forensics-resume-'));
+  const a = spawnSync(process.execPath, [path.join(ROOT, 'dev', 'agent.mjs'), '--headless', '--fresh', '--tick', '0', '--backoff-scale', '0.05', '--interrupt-after', '35'], { env: { ...process.env, AGENT_DATA: D2 }, encoding: 'utf8', timeout: 10 * 60 * 1000 });
+  check('interrupted run exits with checkpoint code 13', a.status === 13, `exit=${a.status}`);
+  const b = spawnSync(process.execPath, [path.join(ROOT, 'dev', 'agent.mjs'), '--headless', '--tick', '0', '--backoff-scale', '0.05', '--max-tasks', '80'], { env: { ...process.env, AGENT_DATA: D2 }, encoding: 'utf8', timeout: 10 * 60 * 1000 });
+  const s2 = JSON.parse(fs.readFileSync(path.join(D2, 'state.json'), 'utf8'));
+  check('resumed run reports resume in counters', (s2.counters?.resumed || 0) >= 1, `resumed=${s2.counters?.resumed}`);
+  const j2 = fs.readFileSync(path.join(D2, 'journal.jsonl'), 'utf8').trim().split('\n').map(l => JSON.parse(l));
+  const updates = j2.filter(e => e.phase === 'update' && e.data && e.data.key).map(e => e.data.key);
+  const seen = new Set(); let dupExec = 0;
+  for (const k of updates) { if (seen.has(k)) dupExec++; seen.add(k); }
+  check('no task executed twice across interrupt/resume', dupExec === 0, `${updates.length} keyed state-updates, ${dupExec} duplicates`);
+  check('second segment stopped by its own budget (bounded)', !!s2.stopped, s2.stopped?.reason);
+  void b;
+}
+
+/* ---------- 11. observer dashboard read-only audit ---------- */
+const html = fs.readFileSync(path.join(ROOT, 'investigations', 'index.html'), 'utf8');
+check('dashboard: no <form> elements', !/<form/i.test(html));
+check('dashboard: no POST anywhere', !/POST/.test(html));
+check('dashboard: no inline event-handler attributes', !/\son[a-z]+\s*=/i.test(html));
+const scripts = [...html.matchAll(/<script>([\s\S]*?)<\/script>/g)].map(m => m[1]);
+let parses = true;
+for (const s of scripts) { try { new Function(s); } catch (e) { parses = false; console.log('   inline script parse error:', e.message); } }
+check('dashboard: inline script parses', scripts.length === 1 && parses);
+const fetches = [...html.matchAll(/fetch\(([^)]*)\)/g)].map(m => m[1]);
+check('dashboard: every fetch is GET-only', fetches.length >= 1 && fetches.every(f => /method:\s*'GET'/.test(f) || !/method/.test(f)), `${fetches.length} raw fetch call site(s), rest via GET-only api() wrapper`);
+check('dashboard: exposes export links (GET downloads)', /\/api\/exports\/journal\.jsonl/.test(html) && /\/api\/exports\/state\.json/.test(html));
+check('dashboard: states the no-control observer contract', /read-only observation/i.test(html) && /no controls/i.test(html));
+for (const f of ['space-grotesk-latin-400-normal.woff2', 'ibm-plex-mono-latin-400-normal.woff2']) check(`dashboard: vendored font present (${f})`, fs.existsSync(path.join(ROOT, 'investigations', 'vendor', 'fonts', f)));
+
+/* ---------- 12. budgets + reproducibility ---------- */
+check('task budget respected', state.counters.tasks <= state.config.maxTasks, `${state.counters.tasks}/${state.config.maxTasks}`);
+check('pair budget respected', state.counters.refined <= state.config.maxPairs, `${state.counters.refined}/${state.config.maxPairs}`);
+const sha = crypto.createHash('sha256').update(fs.readFileSync(path.join(ROOT, 'dev', 'agent.mjs'))).digest('hex').slice(0, 16);
+check('recorded code sha matches controller source', state.codeSha === sha, state.codeSha);
+check('seed recorded for reproducibility', Number.isInteger(state.seed), `seed=${state.seed}`);
+
+console.log(`\n${checks - failures}/${checks} checks passed${failures ? ` — ${failures} FAILURE(S)` : ' — acceptance complete'}`);
+process.exit(failures ? 1 : 0);
