--- /dev/null
+++ b/dev/probe.mjs
@@ -0,0 +1,97 @@
+#!/usr/bin/env node
+/*
+ * Signal-separation probe — tuning tool for dev/agent.mjs thresholds.
+ *
+ *   AGENT_NO_BOOT=1 node dev/probe.mjs
+ *
+ * Builds the stub corpus in a scratch dir, then measures every signal
+ * (orientation-aware hashes, block NCC, edge cosine, full alignment fit,
+ * high-frequency residual) on: the planted ground-truth relationships and a
+ * random-pair sample, split by metadata linkage. Prints the percentiles the
+ * gate/floor constants in dev/agent.mjs are chosen from. Nothing here ships.
+ */
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+process.env.AGENT_NO_BOOT = '1';
+const A = await import('./agent.mjs');
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'probe-'));
+const corpus = A.buildCorpus(dir, { seed: 20261011, writeTruth: true });
+const truth = JSON.parse(fs.readFileSync(path.join(dir, 'truth.json'), 'utf8'));
+
+const imgs = {}, prints = {};
+for (const id of Object.keys(corpus.panels)) {
+  imgs[id] = A.pngDecode(fs.readFileSync(path.join(dir, 'corpus', id + '.png')));
+  prints[id] = A.fingerprint(imgs[id]);
+}
+const gray = id => ({ w: imgs[id].w, h: imgs[id].h, vals: A.grayOf(imgs[id]) });
+
+const hashSim = (pa, pb) => { let s = 0; for (const oi of [0, 1, 2, 3]) s = Math.max(s, A.hamSim(pa.hashes[oi].a, pb.hashes[0].a), A.hamSim(pa.hashes[oi].d, pb.hashes[0].d)); return s; };
+const winSim = (pa, pb) => { let s = 0; for (const w of pb.win) s = Math.max(s, A.hamSim(pa.hashes[0].a, w)); for (const w of pa.win) s = Math.max(s, A.hamSim(w, pb.hashes[0].a)); return s; };
+function metaLinked(a, b) {
+  const A1 = corpus.papers[a.paper], B1 = corpus.papers[b.paper];
+  if (a.paper === b.paper) return 'same paper';
+  if (A1.refs.includes(b.paper) || B1.refs.includes(a.paper)) return 'citation';
+  if (A1.authors.some(x => B1.authors.includes(x))) return 'coauthor';
+  if (A1.group === B1.group) return 'group';
+  return null;
+}
+function fullSignals(a, b) {
+  const pa = prints[a], pb = prints[b];
+  const al = A.alignSearch(gray(a), gray(b));
+  return { h: hashSim(pa, pb), win: winSim(pa, pb), blk: A.vecNcc(pa.blockSig, pb.blockSig), edg: A.cosSim(pa.edgeHist, pb.edgeHist), fit: al.fit, ov: al.ov, resid: A.residScore(gray(a), gray(b), al.T), T: al, meta: metaLinked(corpus.panels[a], corpus.panels[b]) };
+}
+const f3 = x => x.toFixed(3);
+function report(label, list) {
+  if (!list.length) return console.log(label, 'none');
+  const q = (k, p) => { const s = list.map(x => x[k]).sort((a, b) => a - b); return f3(s[Math.min(s.length - 1, Math.floor(p * s.length))]); };
+  console.log(label.padEnd(16), `n=${String(list.length).padStart(4)}`,
+    `h ${q('h', .5)}/${q('h', .9)}/${f3(Math.max(...list.map(x => x.h)))}`,
+    `win ${q('win', .5)}/${q('win', .9)}/${f3(Math.max(...list.map(x => x.win)))}`,
+    `blk ${q('blk', .9)}/${f3(Math.max(...list.map(x => x.blk)))}`,
+    `fit ${q('fit', .5)}/${q('fit', .9)}/${f3(Math.max(...list.map(x => x.fit)))}`,
+    `resid ${q('resid', .9)}/${f3(Math.max(...list.map(x => x.resid)))}`);
+}
+console.log('metric cols: p50/p90/max\n');
+
+const rel = [];
+for (const d of truth.dup) { const s = fullSignals(d.a, d.src); rel.push({ tag: 'DUP ' + JSON.stringify(d.spec).slice(0, 42), a: d.a, b: d.src, ...s }); }
+for (const d of truth.benign) { const s = fullSignals(d.a, d.src); rel.push({ tag: 'BEN ' + d.why, a: d.a, b: d.src, ...s }); }
+for (const d of truth.family) { const s = fullSignals(d.a, d.b); rel.push({ tag: 'FAM', a: d.a, b: d.b, ...s }); }
+for (const r of rel) console.log(` ${r.tag.padEnd(46)} ${r.a} ↔ ${r.b}: h=${f3(r.h)} win=${f3(r.win)} blk=${f3(r.blk)} fit=${f3(r.fit)} ov=${f3(r.ov)} resid=${f3(r.resid)} stage=${r.T.stage} meta=${r.meta || '-'}`);
+
+const ids = Object.keys(prints);
+const relSet = new Set([...truth.dup.map(d => [d.a, d.src].sort().join('|')), ...truth.benign.map(d => [d.a, d.src].sort().join('|')), ...truth.family.map(d => [d.a, d.b].sort().join('|'))]);
+let s2 = 42; const rnd01 = () => { s2 = (s2 * 1103515245 + 12345) & 0x7FFFFFFF; return s2 / 0x7FFFFFFF; };
+const rand = [], randMeta = [];
+while (rand.length + randMeta.length < 420) {
+  const a = ids[(rnd01() * ids.length) | 0], b = ids[(rnd01() * ids.length) | 0];
+  if (a === b) continue; const k = [a, b].sort().join('|');
+  if (relSet.has(k)) continue;
+  const s = fullSignals(a, b);
+  (s.meta ? randMeta : rand).push(s);
+}
+console.log();
+report('RANDOM(nometa)', rand);
+report('RANDOM(meta)', randMeta);
+
+/* gate simulation at the configured thresholds (keep in sync with dev/agent.mjs config.gates) */
+for (const G of [
+  { hash: 0.78, block: 0.50, win: 0.82, metaHash: 0.66, metaBlock: 0.30, metaWin: 0.74 },
+  { hash: 0.78, block: 0.50, win: 0.82, metaHash: 0.68, metaBlock: 0.32, metaWin: 0.76 },
+]) {
+  const cross = r => r.meta && r.meta !== 'same paper';
+  const pass = r => r.h >= G.hash || r.blk >= G.block || r.win >= G.win
+    || (cross(r) && (r.h >= G.metaHash || r.blk >= G.metaBlock || r.win >= G.metaWin));
+  const rp = rand.filter(pass).length, mp = randMeta.filter(pass).length;
+  const missed = rel.filter(r => !r.tag.startsWith('BEN') && !pass(r));
+  console.log(`\ngate ${JSON.stringify(G)}: random-nometa pass ${rp}/${rand.length} (${(100 * rp / rand.length).toFixed(0)}%), random-meta pass ${mp}/${randMeta.length} (${(100 * mp / randMeta.length).toFixed(0)}%), planted missed at gate: ${missed.map(m => m.tag + ' ' + m.a + '↔' + m.b + '(h' + f3(m.h) + ',win' + f3(m.win) + ',blk' + f3(m.blk) + ')').join(' ') || 'none'}`);
+}
+console.log('\ntop random pairs by fit (firewall check — confirmed needs fit≥strong floor AND resid≥resid floor):');
+for (const r of [...rand, ...randMeta].sort((a, b) => b.fit - a.fit).slice(0, 10)) console.log(`  fit=${f3(r.fit)} resid=${f3(r.resid)} h=${f3(r.h)} meta=${r.meta || '-'} (${r.tag || 'rand'})`);
+/* closure pairs (both derived from a common source) — expected relations, not FPs */
+const der = {};
+for (const d of [...truth.dup, ...truth.benign]) { (der[d.src] = der[d.src] || []).push(d.a); }
+for (const [s, kids] of Object.entries(der)) if (kids.length > 1) console.log('closure pair:', kids.join(' ↔ '), '(via', s + ')');
+fs.rmSync(dir, { recursive: true, force: true });
