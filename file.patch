+  else h += `<div class="row"><div><div class="row-title">Running — current task: <span class="mono">${esc(s.currentTask ? s.currentTask.kind + ' ' + (s.currentTask.label || '') : 'selecting…')}</span></div><div class="row-meta">started ${esc(ago(s.startedAt))} ago · run ${esc(s.runId || '')} · seed ${esc(String(s.seed ?? ''))} · code sha ${esc(s.codeSha || '')}</div></div></div>`;
+  if (s.resumedFrom) h += `<div class="row"><div class="row-meta">resumed from checkpoint ${esc(s.resumedFrom)}</div></div>`;
