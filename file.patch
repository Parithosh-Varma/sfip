+  svg += `</svg>`;
+  $('#graph').innerHTML = `<div class="card"><div class="card-h"><h2>Investigation graph</h2><span class="sub">${papers.length} papers · ${finds.length} findings · citation + coauthor + finding edges</span></div>${svg}
