+  h += `</div></div>`;
+  h += `<div class="card"><div class="card-h"><h2>Calibration background</h2><span class="sub">auxiliary-signal percentiles reference this</span></div><div class="card-b">`;
+  h += s.background ? `<div class="kv"><b>sampled pairs</b><span>${s.background.n}</span><b>fit mean ± std</b><span>${f3(s.background.fitMean)} ± ${f3(s.background.fitStd)}</span><b>fit max</b><span>${f3(s.background.fitMax)}</span></div>
+    <div class="row-meta" style="margin-top:8px">Classification floors are probe-validated absolute constants; live quantiles are provenance only. A similarity claim is always a percentile of this background plus a residual cross-check — never a raw score.</div>` : `<div class="state load">calibration pending…</div>`;
+  h += `</div></div></div><div>`;
+  h += `<div class="card"><div class="card-h"><h2>Frontier (priorized, not yet executed)</h2><span class="sub">expected-information-gain / cost</span></div><div class="rows">`;
+  h += (s.frontier || []).slice(0, 12).map(t => `<div class="row"><div style="flex:1"><div class="row-title mono">${esc(t.kind)} ${esc(t.key || '')}</div><div class="row-meta">eig ${f3(t.eig)} / cost ${t.cost} → prio ${f3((t.eig || 0) / (t.cost || 1))} · ${esc(t.why || '')}</div></div></div>`).join('') || '<div class="empty">frontier empty</div>';
+  h += `</div></div>`;
+  h += `<div class="card"><div class="card-h"><h2>Failed operations</h2><span class="sub">bounded retries, then recorded — investigation continues</span></div><div class="rows">`;
+  h += (s.failedOps || []).map(f => `<div class="row"><div style="flex:1"><div class="row-title"><span class="badge err">${esc(f.kind)}</span> <span class="mono">${esc(f.label || f.key || '')}</span></div><div class="row-meta">${esc(f.error || '')} after ${f.tries} attempts · ${esc(ago(f.at))} ago</div></div></div>`).join('') || '<div class="empty">none — every operation succeeded within its retry bound</div>';
+  h += `</div></div></div></div>`;
+  h += `<div class="card"><div class="card-h"><h2>Live reasoning feed</h2><span class="sub">score / update / retry / error events from the journal</span></div><div class="rows" id="feed"></div></div>`;
+  $('#overview').innerHTML = h;
+  renderFeed();
+}
+function renderFeed() {
+  const el = $('#feed'); if (!el) return;
+  const evs = D.journal.filter(e => ['score', 'update', 'retry', 'error'].includes(e.phase)).slice(-14).reverse();
+  el.innerHTML = evs.map(e => `<div class="row"><span class="badge info mono">${esc(e.phase)}</span><div style="flex:1"><div class="row-meta" style="color:var(--ink)">${esc(e.msg || '')}</div><div class="row-meta">#${e.seq} · ${esc(e.t || '')}</div></div></div>`).join('') || '<div class="empty">waiting for events…</div>';
+}
+function renderFindings() {
+  const list = D.findings.slice().sort((a, b) => (b.rank || 0) - (a.rank || 0));
+  const filt = D.fFilter;
+  const shown = list.filter(f => filt === 'all' || f.classification === filt);
+  let h = `<div class="policy"><div class="eyebrow">interpretation policy — enforced on every record below</div>
+    <p>${esc((D.findings[0] && D.findings[0].policy) || 'This record documents an observed image similarity. It is not a determination of misconduct or intent.')}</p>
+    <p style="color:var(--muted);font-size:12px">Similarity ≠ fraud. Each flag lists alternative interpretations; observed evidence is kept strictly separate from any conclusion about intent, which is a matter for qualified reviewers, not this system.</p></div>`;
+  h += `<div class="card"><div class="chips">`;
+  for (const [k, lab] of [['all', 'all ' + list.length], ['potential-duplication', 'potential duplication'], ['weak-evidence', 'weak evidence'], ['explained-reuse', 'explained reuse']])
+    h += `<button class="chip" aria-pressed="${filt === k}" data-f="${k}">${esc(lab)}</button>`;
+  h += `</div><div class="rows" style="padding:0">`;
+  h += shown.map(f => {
+    const [bk] = CLS[f.classification] || ['info'];
+    const open = D.focusFinding === f.id;
+    return `<details class="fx" ${open ? 'open' : ''} data-fid="${esc(f.id)}">
+      <summary><span class="badge ${bk}">${esc((CLS[f.classification] || [,'?'])[1])}</span>
+        <span class="row-title mono">${esc(f.id)} · ${esc(f.a)} ↔ ${esc(f.b)}</span>
+        <span class="row-meta">fit ${f3(f.fit)} · resid ${f3(f.resid)} · overlap ${pct(f.ov)} · ${esc(f.corroboration || '')} · agreement ${f3(f.agreement)} · rank ${f.rank ?? '—'}</span></summary>
+      <div class="body">
+        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start">
+          <img class="thumb" loading="lazy" src="/img/panel/${esc(f.a)}.png" alt="panel ${esc(f.a)}">
+          <img class="thumb" loading="lazy" src="/img/panel/${esc(f.b)}.png" alt="panel ${esc(f.b)}">
+          <img class="compare" loading="lazy" src="/img/compare/${esc(f.id)}.png" alt="alignment comparison for ${esc(f.id)}: panel A, warped panel B, residual">
+        </div>
+        <div class="kv"><b>rationale</b><span>${esc(f.rationale || '')}</span>
+          <b>transform</b><span class="mono">${esc(fmtT(f.transform))} · stage ${esc(f.stage || '')}</span>
+          <b>percentiles</b><span>fit ${pct(f.pct && f.pct.fit)} · hash ${pct(f.pct && f.pct.hash)} · edge ${pct(f.pct && f.pct.edge)} · block ${pct(f.pct && f.pct.block)} (of pre-screen background)</span>
+          <b>floors at decision</b><span>strong ${f3(f.floors && f.floors.strong)} · weak ${f3(f.floors && f.floors.weak)} · n=${f.floors && f.floors.n}</span>
+          <b>context</b><span>${esc(ctxLine(f))}</span>
+          <b>conflicting signals</b><span>${f.conflicting ? 'yes — geometric match without auxiliary agreement' : 'no'}</span>
+          <b>provenance</b><span class="mono">${esc((f.evidenceRefs || []).join(', '))} (journal seqs)</span></div>
+        <div><div class="eyebrow">reasoning chain</div><ul class="clean">${(f.reasoning || []).map(r => `<li>${esc(r)}</li>`).join('')}</ul></div>
+        <div><div class="eyebrow">alternative interpretations</div><ul class="clean">${(f.altInterpretations || []).map(r => `<li>${esc(r)}</li>`).join('')}</ul></div>
+        ${f.policy ? `<div class="row-meta" style="color:var(--accent-deep)">${esc(f.policy)}</div>` : ''}
+      </div></details>`;
+  }).join('') || '<div class="empty">no findings in this class yet</div>';
+  h += `</div></div>`;
+  $('#findings').innerHTML = h;
+  for (const b of $('#findings').querySelectorAll('.chip')) b.addEventListener('click', () => { D.fFilter = b.dataset.f; renderFindings(); });
+  if (D.focusFinding) { const el = $('#findings').querySelector(`details[data-fid="${CSS.escape(D.focusFinding)}"]`); if (el) el.scrollIntoView({ block: 'center' }); D.focusFinding = null; }
+}
+function ctxLine(f) {
+  const c = f.context || {}; const bits = [];
+  if (c.samePaper) bits.push('same paper');
+  if (c.loadingControl) bits.push('loading-control caption');
+  if (c.attributed) bits.push('attributed reuse');
+  if ((c.authorOverlap || []).length) bits.push('shared authors: ' + c.authorOverlap.join(', '));
+  if (c.citationEdge) bits.push('citation edge');
+  return bits.length ? bits.join(' · ') : 'no metadata link — visual evidence only';
+}
+function fmtT(t) { if (!t) return '—'; return `flip${t.fx ? 'H' : ''}${t.fy ? 'V' : ''} scale ${f3(t.sx)}×${f3(t.sy)} shift ${f3(t.dx)},${f3(t.dy)}`; }
+function renderGraph() {
+  const g = D.graph || { nodes: [], edges: [] };
+  const papers = g.nodes.filter(n => n.type === 'paper').sort((a, b) => a.id.localeCompare(b.id));
+  const finds = g.nodes.filter(n => n.type === 'finding');
+  const W = 1000, H = 660, cx = W / 2, cy = H / 2, R = 285;
+  const pos = {};
+  papers.forEach((p, i) => { const a = (i / Math.max(1, papers.length)) * Math.PI * 2 - Math.PI / 2; pos[p.id] = [cx + R * Math.cos(a), cy + R * Math.sin(a) * 0.92]; });
+  for (const f of finds) { const a = pos[(g.edges.find(e => e.b === f.id) || {}).a] || [cx, cy], b = pos[(g.edges.find(e => e.a === f.id && e.type !== 'cites' && e.type !== 'coauthor') || {}).b] || [cx, cy]; pos[f.id] = [(a[0] + b[0]) / 2 * 0.72 + cx * 0.28, (a[1] + b[1]) / 2 * 0.72 + cy * 0.28]; }
+  const EC = { cites: ['#b9b9ab', '3,4'], coauthor: ['#9db4d0', '1,4'], dup: ['#c23101', ''], explained: ['#2f7d4f', ''], weak: ['#c9a24a', '6,3'] };
+  let svg = `<svg class="graph" viewBox="0 0 ${W} ${H}" role="img" aria-label="investigation graph: papers, citation and coauthor links, and findings">`;
+  for (const e of g.edges) {
+    if (e.type === 'cites' || e.type === 'coauthor') { const a = pos[e.a], b = pos[e.b]; if (!a || !b) continue; const [col, dash] = EC[e.type]; svg += `<line x1="${a[0].toFixed(1)}" y1="${a[1].toFixed(1)}" x2="${b[0].toFixed(1)}" y2="${b[1].toFixed(1)}" stroke="${col}" stroke-width="1" stroke-dasharray="${dash}" opacity=".55"/>`; }
+  }
+  for (const e of g.edges) {
+    if (e.type === 'cites' || e.type === 'coauthor') continue;
+    const a = pos[e.a], b = pos[e.b]; if (!a || !b) continue; const [col, dash] = EC[e.type] || EC.weak;
+    svg += `<line x1="${a[0].toFixed(1)}" y1="${a[1].toFixed(1)}" x2="${b[0].toFixed(1)}" y2="${b[1].toFixed(1)}" stroke="${col}" stroke-width="2" ${dash ? `stroke-dasharray="${dash}"` : ''} opacity=".8"/>`;
+  }
+  for (const p of papers) { const [x, y] = pos[p.id]; svg += `<circle class="n-paper" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="15"/>
+    <text x="${x.toFixed(1)}" y="${(y + 3.5).toFixed(1)}" text-anchor="middle">${esc(p.id.replace('p0', 'p').replace('p', ''))}</text>
+    <title>${esc(p.id + ' — ' + (p.title || ''))} (${esc(p.status || '')})</title>`; }
+  for (const f of finds) { const [x, y] = pos[f.id]; const col = f.cls === 'potential-duplication' ? '#c23101' : f.cls === 'explained-reuse' ? '#2f7d4f' : '#c9a24a';
