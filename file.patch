+/* ------------------------------------------------- procedural panels ---- */
+/* Deterministic synthetic figure panels: blots, gels, microscopy, plots.
+   Stands in for "figures extracted from fetched papers" in the real pipeline. */
+const KIND_DIM = { blot: [320, 180], gel: [300, 240], micro: [260, 260], plot: [300, 200] };
